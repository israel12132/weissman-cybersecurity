{
  "name": "weissman-briefing-pdf",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Renders the Weissman Cybersecurity company & system briefing (Hebrew + English) into print-quality PDFs.",
  "scripts": {
    "build:he": "node render.mjs '../../Weissman_Cybersecurity_מסמך_טכני_מנהלי_עברית.md' '../../Weissman_Cybersecurity_מסמך_טכני_מנהלי_עברית.pdf' he",
    "build:en": "node render.mjs '../../Weissman_Cybersecurity_Executive_Technical_Briefing.md' '../../Weissman_Cybersecurity_Executive_Technical_Briefing.pdf' en",
    "build": "npm run build:he && npm run build:en"
  },
  "dependencies": {
    "markdown-it": "^14.3.0",
    "mupdf": "^1.28.0",
    "playwright-core": "^1.61.1",
    "subset-font": "^2.5.0"
  }
}
