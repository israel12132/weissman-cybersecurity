# DEPRECATED: Celery worker replaced with Rust-based weissman-worker
#
# The Python Celery worker has been removed and replaced with the Rust
# weissman-worker crate. This Dockerfile is kept for historical reference only.
#
# For production, use:
#   docker build -f deploy/backend.Dockerfile .
#
# Or use the Rust worker directly:
#   cargo run -p weissman-worker
#
# This file will be removed in a future cleanup.

FROM python:3.14-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Intentionally fail with clear error message
CMD ["sh", "-c", "echo 'ERROR: Dockerfile.worker is deprecated. Use deploy/backend.Dockerfile or cargo run -p weissman-worker' >&2; exit 1"]
