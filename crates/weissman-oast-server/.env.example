# Copy to .env for local runs. Do not commit .env with secrets.
DATABASE_URL=postgres://weissman_app:password@127.0.0.1:5432/weissman

# Wildcard DNS must resolve *.{domain} to this service (e.g. Cloudflare → origin).
# Placeholder boots the listener without a public zone.
WEISSMAN_OAST_DOMAIN=oast.localhost
# WEISSMAN_OAST_BASE_DOMAIN=oast.localhost

OAST_HTTP_LISTEN=0.0.0.0:9091
OAST_DNS_LISTEN=0.0.0.0:5353,0.0.0.0:53
# Compose host publishes (docker-compose.yml): 9091:9091, 53:53/udp, 5353:5353/udp.
# OAST_DNS_ENABLE=1
# WEISSMAN_OAST_API_KEY=
