{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Weissman Cybersecurity Platform — application, scan, and security metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(weissman_errors_total[5m])) / sum(rate(http_requests_total[5m])) * 100",
          "legendFormat": "error %",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Scans",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "weissman_orchestrator_active_tenant_cycles",
          "legendFormat": "active scans",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Scan P50 / P95 / P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(weissman_scan_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(weissman_scan_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(weissman_scan_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Rate Limit Violations (per min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(weissman_rate_limit_violations_total[1m])) by (key_prefix) * 60",
          "legendFormat": "{{key_prefix}}",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 6,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(weissman_cache_operations_total{operation='hit'}[5m])) / sum(rate(weissman_cache_operations_total[5m])) * 100",
          "legendFormat": "hit rate",
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 60 }, { "color": "green", "value": 80 }] }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["weissman", "security", "saas"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Weissman Platform",
  "uid": "weissman-platform",
  "version": 1
}
