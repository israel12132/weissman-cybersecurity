# Optional local overrides for `./start_weissman.sh`.
# Copy to `.env.local` (gitignored). The launcher starts Docker Postgres + Redis
# and fills these if unset — you only need this file to persist JWT/admin secrets
# or to point at a non-default datastore.
#
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/weissman
# WEISSMAN_MIGRATE_URL=postgres://postgres:postgres@127.0.0.1:5432/weissman
# REDIS_URL=redis://127.0.0.1:6379/0
# WEISSMAN_ENV=development
# WEISSMAN_COOKIE_SECURE=0
# WEISSMAN_JWT_SECRET=
# WEISSMAN_ADMIN_EMAIL=admin@localhost
# WEISSMAN_ADMIN_PASSWORD=
