WEISSMAN_NUMA_PIN=

# -----------------------------------------------------------------------------
# Rate limiting (src/rate_limiter.py — Python worker / API layer)
# -----------------------------------------------------------------------------

# Login endpoint: max attempts per window per IP address.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60

# Full scan trigger: max triggers per window per tenant.
RATE_LIMIT_SCAN_MAX=5
RATE_LIMIT_SCAN_WINDOW=60

# Command-center single scan: max requests per window per tenant.
RATE_LIMIT_CC_SCAN_MAX=10
RATE_LIMIT_CC_SCAN_WINDOW=60

# Deep-fuzz endpoint: max requests per window per tenant (5-minute default window).
RATE_LIMIT_FUZZ_MAX=3
RATE_LIMIT_FUZZ_WINDOW=300

# -----------------------------------------------------------------------------
# Feed cache (src/feed_cache.py — Python worker / API layer)
# -----------------------------------------------------------------------------

# How long (in seconds) external feed results are cached before re-fetching.
# Defaults to 300 s (5 min). Increase to reduce external API calls further.
FEED_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# SSRF protection bypass (src/scope_validator.py) — NEVER enable in production
# -----------------------------------------------------------------------------

# WARNING: Setting this to 1 disables SSRF checks and allows scanning private
# IP ranges and cloud metadata endpoints. Must NEVER be set to 1 in production.
# BYPASS_SSRF_CHECK=0

# -----------------------------------------------------------------------------
# Tests only (do not set in production)
# -----------------------------------------------------------------------------

# TEST_DATABASE_URL=   # crates/weissman-db/tests/rls_cross_tenant.rs

# =============================================================================
# Docker Compose Database Credentials
# =============================================================================
# REQUIRED FOR PRODUCTION: Set these to strong, unique values when deploying
# with Docker Compose. NEVER use the default development values in production.
# These variables correspond to the database credentials in docker-compose.yml.
# -----------------------------------------------------------------------------

# PostgreSQL superuser credentials (used by postgres service).
# Only POSTGRES_PASSWORD is a secret to set — the launcher generates it.
# LEAVE POSTGRES_USER AND POSTGRES_DB BLANK: several migrations hardcode the role name
# `postgres` and the database name `weissman` (e.g. ALTER DEFAULT PRIVILEGES FOR ROLE
# postgres, and GRANTs in the weissman DB). Overriding them makes migrations fail and the
# backend crash-loop. Blank => compose uses the matching defaults postgres / weissman.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Application database role credentials (RLS-protected app user)
# Default dev values: weissman_app / weissman_dev_secret
DB_APP_USER=
DB_APP_PASSWORD=

# Authentication database role credentials (BYPASSRLS auth user)
# Default dev values: weissman_auth / weissman_auth_dev
DB_AUTH_USER=
DB_AUTH_PASSWORD=

# Read-only role for "Ask Weissman" (NL->SQL, /api/ask). SELECT-only, 15s statement
# timeout, RLS-scoped. Leave DB_RO_USER blank (migration hardcodes `weissman_ro`).
# DB_RO_PASSWORD is auto-generated by ./start_weissman_live.sh; the boot role-sync applies
# it and restores LOGIN. Leaving it blank disables /api/ask (503) and, in production, the
# weissman_ro role is stripped of LOGIN as defence-in-depth.
# Default dev value: weissman_ro / weissman_ro_dev
DB_RO_USER=
DB_RO_PASSWORD=
