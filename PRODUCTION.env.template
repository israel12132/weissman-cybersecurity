# -----------------------------------------------------------------------------
# OAST — out-of-band interaction listener (blind SSRF / XXE / Log4Shell correlation)
# binary: weissman-oast-server (crates/weissman-oast-server); records to oast_interaction_hits
# -----------------------------------------------------------------------------
# OPTIONAL, OFF by default. When WEISSMAN_OAST_DOMAIN is set, ./start_weissman_live.sh also
# starts the `oast` service (docker-compose.prod.yml, profile `oast`) and the engines emit
# *confirmed* callback findings instead of an informational "not configured" note.
#
# It needs a DNS zone you control, delegated to this host. LEAVE THIS BLANK unless you have
# delegated one — a hardcoded value (previously the vendor's domain) would send every
# customer's callbacks to someone else's collector.
# Setup: delegate e.g. oast.yourcompany.com (NS) to this server and make the ports below
# reachable (DNS/udp + HTTP callback catcher).
WEISSMAN_OAST_DOMAIN=
# Bearer shared by the listener and the scan engines for the correlation API.
# Auto-generated by ./start_weissman_live.sh. Generate: openssl rand -base64 48
WEISSMAN_OAST_API_KEY=
# Where the engines poll recorded callbacks. Inside compose this is the oast service.
WEISSMAN_OAST_LISTENER_URL=http://oast:9090
# Host ports the oast container publishes. Defaults avoid clashing with Prometheus (9090)
# and the host resolver (53). Route your public :53/udp and HTTP callbacks to these.
WEISSMAN_OAST_HTTP_PORT=9091
WEISSMAN_OAST_DNS_PORT=5353
# WEISSMAN_OAST_LISTENER_URL=http://127.0.0.1:9090

# OAST / OOB in payloads (fingerprint_engine/src/fuzz_oob.rs).
# If WEISSMAN_OAST_DOMAIN or WEISSMAN_OAST_BASE_DOMAIN is set, embed defaults to http://{token}.{domain}/i and verify to {WEISSMAN_OAST_LISTENER_URL}/api/oast/status/{token}.
# Override wire templates (must include {token}):
# WEISSMAN_OAST_EMBED_TEMPLATE=https://your-interact-server.example/{token}
# WEISSMAN_OAST_VERIFY_URL=https://your-interact-server.example/verify/{token}
# Plain status response must contain this substring when the token has hits (default oob_hit).
# WEISSMAN_OAST_HIT_SUBSTRING=oob_hit
# Max mutation-derived probes to instrument with OAST per run (default 64).
# WEISSMAN_OAST_MAX_PROBES=64

# Generative vLLM feedback fuzz (fingerprint_engine/src/generative_fuzz_llm.rs, default ON).
# Set to 0/false/off to use legacy static mutations (FUZZ_PAYLOADS_FILE + fuzz_core mutator).
# WEISSMAN_GENERATIVE_FUZZ=1
# Channel buffer + refill threshold, max POST probes per run, LLM HTTP timeout (seconds).
# WEISSMAN_GENERATIVE_FUZZ_CHANNEL_CAP=256
# WEISSMAN_GENERATIVE_FUZZ_LOW_WATER=56
# WEISSMAN_GENERATIVE_FUZZ_MAX_POST_PROBES=640
# WEISSMAN_GENERATIVE_FUZZ_LLM_TIMEOUT_SECS=300
# WEISSMAN_GENERATIVE_FUZZ_TEMPERATURE=0.55
# WEISSMAN_GENERATIVE_FUZZ_MAX_TOKENS=4096
# Comma-separated stack hints injected into LLM prompts (e.g. php,graphql,java).
# WEISSMAN_FUZZ_TECH_STACK=

# Optional egress proxies for fingerprinting and fuzz HTTP pool: comma-separated URLs or one host:port per line in file.
PROXIES_LIST=
PROXIES_FILE=

# Region code for data-residency enforcement.
# IL = Israel (required for Israeli regulated financial entities — Bank of Israel Directive 361).
# Supported: IL | EU-West | US-East | AU-East
# Default: IL
WEISSMAN_REGION=IL

