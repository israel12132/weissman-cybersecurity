{
  "name": "weissman-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/generate_engine_param_defs.mjs && bash ../scripts/build-ui-provenance-wasm.sh && bash ../scripts/build-ast-cap-wasm.sh && node ../scripts/verify-import-cycles.mjs && node ../scripts/verify-provider-wiring.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui-audit": "node ../scripts/weissman-ui-audit.mjs",
    "test:e2e:live": "PLAYWRIGHT_LIVE=1 playwright test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.1",
    "framer-motion": "^11.11.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.22.0",
    "react-simple-maps": "^3.0.0",
    "react-window": "^1.8.10",
    "recharts": "^2.12.0",
    "three": "^0.160.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "vite": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-dispatch": "^3.0.1",
    "d3-timer": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-drag": "^3.0.0"
  }
}
