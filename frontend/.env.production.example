# Frontend production environment example.
# Copy to .env.production and tweak per deployment.

# Origin of the API server. Used by getApiBase() in src/lib/apiBase.js.
# Leave empty (or unset) to use same-origin (recommended when nginx proxies /api).
VITE_API_BASE_URL=

# Optional: branding flag — show "Weissman Cybersecurity" labels.
VITE_PRODUCT_NAME=Weissman Cybersecurity
