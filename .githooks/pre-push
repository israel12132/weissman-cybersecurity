#!/usr/bin/env bash
# .githooks/pre-push — the fast half of CI, run BEFORE anything leaves this machine.
#
# WHY: main went red in September 2026 because a commit was pushed without `cargo fmt`, the
# handler-honesty ratchet regressed, and a new Rust module referenced by lib.rs was left
# untracked (which compiles locally and breaks every clean checkout). None of that survives
# this hook. It runs only cheap, deterministic checks (seconds, no cargo build); the heavy
# gates (clippy, tests, e2e) stay in CI.
#
# Install once per clone:  scripts/install_git_hooks.sh   (sets core.hooksPath = .githooks)
# Skip in an emergency:    WEISSMAN_SKIP_HOOKS=1 git push   (the push is still gated by CI)
set -euo pipefail

if [[ "${WEISSMAN_SKIP_HOOKS:-0}" == "1" ]]; then
  echo "pre-push: WEISSMAN_SKIP_HOOKS=1 — skipping local gates (CI still applies)" >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail=0
red()   { printf '\033[31m✖ %s\033[0m\n' "$*" >&2; fail=1; }
green() { printf '\033[32m✔ %s\033[0m\n' "$*" >&2; }
have()  { command -v "$1" >/dev/null 2>&1; }

# 1) Untracked source that committed code references — the "works on my machine" trap.
#    Every `pub mod x;` / `mod x;` in a tracked Rust file must resolve to a TRACKED file.
missing_mods=""
while IFS= read -r decl; do
  file="${decl%%:*}"; modname="$(sed -E 's/.*\bmod[[:space:]]+([A-Za-z0-9_]+)[[:space:]]*;.*/\1/' <<<"${decl#*:}")"
  dir="$(dirname "$file")"
  # lib.rs / main.rs / mod.rs declare siblings; other files declare into a same-named dir.
  base="$(basename "$file")"
  if [[ "$base" == "lib.rs" || "$base" == "main.rs" || "$base" == "mod.rs" ]]; then
    cands=("$dir/$modname.rs" "$dir/$modname/mod.rs")
  else
    stem="${base%.rs}"
    cands=("$dir/$stem/$modname.rs" "$dir/$stem/$modname/mod.rs")
  fi
  found=0
  for c in "${cands[@]}"; do
    if git ls-files --error-unmatch "$c" >/dev/null 2>&1; then found=1; break; fi
  done
  if [[ $found -eq 0 ]]; then
    # Inline `mod x { ... }` blocks and #[path] overrides are rare here; only flag when the
    # file exists on disk but is untracked (the exact failure mode we are guarding against).
    for c in "${cands[@]}"; do
      if [[ -f "$c" ]]; then missing_mods+="  $file → $c (exists on disk, NOT tracked by git)"$'\n'; fi
    done
  fi
done < <(git grep -nE '^[[:space:]]*(pub(\([a-z]+\))?[[:space:]]+)?mod[[:space:]]+[A-Za-z0-9_]+[[:space:]]*;' -- '*.rs' ':!target' ':!legacy' | sed -E 's/^([^:]+):[0-9]+:/\1:/')
if [[ -n "$missing_mods" ]]; then
  red "Rust modules referenced by tracked code are untracked (git add them):"
  printf '%s' "$missing_mods" >&2
else
  green "every declared Rust module is tracked"
fi

# 1b) include_bytes!/include_str! assets must be tracked too.
missing_assets=""
while IFS= read -r line; do
  file="${line%%:*}"; rel="$(sed -E 's/.*include_(bytes|str)!\("([^"]+)"\).*/\2/' <<<"${line#*:}")"
  target="$(cd "$(dirname "$file")" && realpath -m "$rel" 2>/dev/null | sed "s#^$ROOT/##")"
  if [[ -n "$target" && -f "$target" ]] && ! git ls-files --error-unmatch "$target" >/dev/null 2>&1; then
    missing_assets+="  $file → $target"$'\n'
  fi
done < <(git grep -nE 'include_(bytes|str)!\("[^"]+"\)' -- '*.rs' ':!target' ':!legacy' | sed -E 's/^([^:]+):[0-9]+:/\1:/')
if [[ -n "$missing_assets" ]]; then
  red "embedded assets referenced by tracked code are untracked (git add them):"
  printf '%s' "$missing_assets" >&2
else
  green "every include_bytes!/include_str! asset is tracked"
fi

# 2) rustfmt — the exact CI command. Seconds, no build.
if have cargo; then
  if cargo fmt --all --check >/dev/null 2>&1; then
    green "cargo fmt --all --check"
  else
    red "cargo fmt --all --check failed — run: cargo fmt --all"
  fi
else
  echo "pre-push: cargo not found, skipping rustfmt" >&2
fi

# 3) Node-based CI ratchets/contracts (all read-only, all fast).
if have node; then
  for gate in \
    "scripts/verify_handler_honesty.mjs" \
    "scripts/sync_doc_metrics.mjs --check" \
    "scripts/verify_doc_metrics.mjs" \
    "scripts/verify_frontend_route_contract.mjs" \
    "scripts/verify_i18n_no_default_values.mjs" \
    "scripts/verify_i18n_template_keys.mjs"; do
    script="${gate%% *}"
    [[ -f "$script" ]] || continue
    if node $gate >/dev/null 2>&1; then
      green "node $gate"
    else
      red "node $gate failed — run it for details"
    fi
  done
else
  echo "pre-push: node not found, skipping script gates" >&2
fi

# 4) Launcher / compose contract (bash only, ~10s).
if [[ -f scripts/test_launcher_contract.sh ]]; then
  if bash scripts/test_launcher_contract.sh >/dev/null 2>&1; then
    green "scripts/test_launcher_contract.sh"
  else
    red "scripts/test_launcher_contract.sh failed — run it for details"
  fi
fi

# 5) Frontend lint on files changed vs upstream (eslint only; vitest stays in CI).
if have npx && [[ -d frontend/node_modules ]]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo origin/main)"
  changed="$(git diff --name-only "$upstream"...HEAD -- 'frontend/src/**/*.js' 'frontend/src/**/*.jsx' 2>/dev/null | sed 's#^frontend/##' || true)"
  if [[ -n "$changed" ]]; then
    if (cd frontend && npx eslint $changed >/dev/null 2>&1); then
      green "eslint on $(wc -l <<<"$changed") changed frontend file(s)"
    else
      red "eslint failed on changed frontend files — run: cd frontend && npx eslint <files>"
    fi
  fi
fi

if [[ $fail -ne 0 ]]; then
  echo >&2
  echo "pre-push: blocked. Fix the items above (or WEISSMAN_SKIP_HOOKS=1 to bypass — CI will still fail)." >&2
  exit 1
fi
green "pre-push: all local gates green"
