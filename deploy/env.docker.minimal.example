# Minimal `.env` for local Docker (`docker compose up --build`)
# Copy to repo root:  cp deploy/env.docker.minimal.example .env
# Then edit WEISSMAN_ADMIN_PASSWORD and WEISSMAN_JWT_SECRET — never commit `.env` to git.

WEISSMAN_ADMIN_EMAIL=admin@localhost
WEISSMAN_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WEISSMAN_ALLOW_DEFAULT_ADMIN_PASSWORD=1

# Generate: openssl rand -base64 48
WEISSMAN_JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_48
