[Unit]
Description=Weissman async job worker (engine runs — CRITICAL)
Documentation=man:systemd.service(5)
After=network-online.target
Wants=network-online.target
# Worker only needs Postgres, not the HTTP server. Start after DB if local:
# After=postgresql.service
# Requires=postgresql.service

[Service]
Type=simple
User=weissman
Group=weissman
WorkingDirectory=/opt/weissman/app

EnvironmentFile=-/etc/weissman/weissman.env

ExecStart=/opt/weissman/app/bin/weissman-worker

Restart=always
RestartSec=3
StartLimitIntervalSec=0

LimitNOFILE=1048576
TimeoutStopSec=60
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=weissman-worker

# --- Hardening (adjust if you hit permission errors) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Engines make outbound TCP/UDP/DNS probes — keep the inet/unix/netlink families.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Connect-scan uses ordinary sockets (no raw sockets), so no capabilities are needed. If you
# enable raw-socket/SYN scanning, add: CapabilityBoundingSet=CAP_NET_RAW and AmbientCapabilities=CAP_NET_RAW.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
StateDirectory=weissman
ReadWritePaths=/opt/weissman/app /var/lib/weissman

[Install]
WantedBy=weissman.target multi-user.target
