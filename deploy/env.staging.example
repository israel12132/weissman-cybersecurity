# =============================================================================
# Weissman STAGING / GO-LIVE — copy to .env and merge with base compose
# =============================================================================
# Start stack (HTTPS + Secure cookies):
#   cp deploy/env.staging.example .env
#   # fill WEISSMAN_JWT_SECRET (>=48 chars), WEISSMAN_ADMIN_PASSWORD, secrets below
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml \
#     --profile staging --profile staging-tls up -d --build
#
# QA:
#   ./scripts/staging-qa.sh
#   ./scripts/staging-qa.sh --live https://localhost
# =============================================================================

WEISSMAN_ENV=staging
# Required with Secure cookies — use --profile staging-tls (Caddy https://localhost)
WEISSMAN_COOKIE_SECURE=1
WEISSMAN_PUBLIC_BASE_URL=https://localhost

# ─── 1. Paddle pri_* price IDs ─────────────────────────────────────────────
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
WEISSMAN_BILLING_STRICT=1
# From Paddle Dashboard → Catalog → Prices (pri_...)
WEISSMAN_PADDLE_PRICE_STARTER=pri_REPLACE_STARTER
WEISSMAN_PADDLE_PRICE_PROFESSIONAL=pri_REPLACE_PROFESSIONAL
WEISSMAN_PADDLE_PRICE_ENTERPRISE=pri_REPLACE_ENTERPRISE
# Or after boot: psql + deploy/go-live/paddle-price-ids.sql.example

# ─── 2. SMTP (self-serve signup) — Mailpit with --profile staging ───────────
WEISSMAN_SELF_SERVE_SIGNUP=1
WEISSMAN_SMTP_ENABLED=true
WEISSMAN_SMTP_HOST=mailpit
WEISSMAN_SMTP_PORT=1025
WEISSMAN_SMTP_FROM=noreply@weissman.local
WEISSMAN_SMTP_TO=admin@localhost
# Mailpit UI: http://localhost:8025

# ─── 3. LLM (Council, General Mission) — external OpenAI-compatible ───────
# Example: OpenAI cloud
# WEISSMAN_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# WEISSMAN_LLM_MODEL=gpt-4o-mini
# WEISSMAN_LLM_API_KEY=
# OPENAI_API_KEY=
# WEISSMAN_EMBEDDINGS_MODEL=text-embedding-3-small
# WEISSMAN_COUNCIL_SINGLE_MODEL=1
# Example: vLLM on host → http://host.docker.internal:8000/v1
# Example: Ollama → http://host.docker.internal:11434/v1
WEISSMAN_LLM_BASE_URL=
WEISSMAN_LLM_MODEL=
WEISSMAN_LLM_API_KEY=
OPENAI_API_KEY=

# ─── 4. OAST — profile `oast` + wildcard DNS in production ─────────────────
WEISSMAN_OAST_DOMAIN=oast.localhost
WEISSMAN_OAST_LISTENER_URL=http://oast:9090
WEISSMAN_OAST_API_KEY=

# ─── 5. Agent binaries — baked into backend image (linux x64/aarch64) ─────
# WEISSMAN_AGENT_BIN_DIR=/srv/bin/agents  (set in Dockerfile)
# Native dev: ./scripts/package_agent_binaries.sh

# ─── Required secrets (same as production) ────────────────────────────────
# Minimum 32 characters each (required for production; recommended on staging):
WEISSMAN_METRICS_TOKEN=
WEISSMAN_DESTRUCTIVE_CONFIRM_SECRET=
WEISSMAN_JOB_ORCHESTRATOR_SECRET=
WEISSMAN_ADMIN_PASSWORD=
WEISSMAN_ADMIN_EMAIL=admin@localhost
# Minimum 48 characters
WEISSMAN_JWT_SECRET=
