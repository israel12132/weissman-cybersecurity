# Weissman MAX POWER capability profile (no secrets).
# Compiled into weissman-server / weissman-worker via include_str (git pull + rebuild + restart).
# Optional merge into gitignored `.env` with: ./scripts/apply_max_power_env.sh
# Turns every real capability on at the strongest code-allowed setting.
# Does NOT enable security bypasses (insecure TLS, skip SAML verify, disable headers,
# stealth-off, advisory/fake findings, Cloudflare cloak/blackhole without tokens,
# auto-merge of unreviewed heal PRs).

# --- LLM strength (OpenAI cloud; set keys separately) ---
WEISSMAN_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
WEISSMAN_LLM_MODEL=gpt-4o
WEISSMAN_NL_QUERY_MODEL=gpt-4o
WEISSMAN_NL_QUERY_MAX_TOKENS=8192
WEISSMAN_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
WEISSMAN_EMBEDDINGS_MODEL=text-embedding-3-small
WEISSMAN_COUNCIL_EMBEDDING_MODEL=text-embedding-3-small
WEISSMAN_COUNCIL_SINGLE_MODEL=1
WEISSMAN_COUNCIL_MODEL_CODER=gpt-4o
WEISSMAN_COUNCIL_MODEL_GENERALIST=gpt-4o
WEISSMAN_COUNCIL_MODEL_SYNTHESIZER=gpt-4o
WEISSMAN_SUPREME_COUNCIL=1
WEISSMAN_COUNCIL_PARALLEL_ALPHA=1
WEISSMAN_COUNCIL_TIMEOUT_SECS=180
WEISSMAN_COUNCIL_TEMP_ALPHA=0.35
WEISSMAN_COUNCIL_TEMP_BETA=0.2
WEISSMAN_COUNCIL_TEMP_GAMMA=0.25
WEISSMAN_COUNCIL_MAX_TOKENS_ALPHA=4096
WEISSMAN_COUNCIL_MAX_TOKENS_BETA=4096
WEISSMAN_COUNCIL_MAX_TOKENS_GAMMA=8192
WEISSMAN_SUPREME_MEMORY_TOP_K=12
WEISSMAN_REPORT_LLM_DISABLED=0
WEISSMAN_REPORT_LLM_MAX_TOKENS=4096
WEISSMAN_REPORT_LLM_TIMEOUT_SECS=180
WEISSMAN_LLM_DISABLE_JSON_RESPONSE_FORMAT=0
WEISSMAN_SECURITY_EVENTS_LLM_INTERVAL_SECS=600

# --- Core loops ---
WEISSMAN_SCANNING_ENABLED=1
WEISSMAN_DEEP_SCAN=1
WEISSMAN_GENERATIVE_FUZZ=1
WEISSMAN_GENERATIVE_FUZZ_CHANNEL_CAP=256
WEISSMAN_GENERATIVE_FUZZ_LOW_WATER=56
WEISSMAN_GENERATIVE_FUZZ_MAX_POST_PROBES=640
WEISSMAN_GENERATIVE_FUZZ_LLM_TIMEOUT_SECS=300
WEISSMAN_GENERATIVE_FUZZ_TEMPERATURE=0.55
WEISSMAN_GENERATIVE_FUZZ_MAX_TOKENS=4096
WEISSMAN_FUZZ_MAX_IN_FLIGHT=256
WEISSMAN_FUZZ_GLOBAL_RPS=120
WEISSMAN_FUZZ_BURST=240
WEISSMAN_OAST_MAX_PROBES=256
WEISSMAN_GHOST_SWARM_FINGERPRINT=1
WEISSMAN_BOLA_AUTONOMOUS_IDENTITY=1
WEISSMAN_BOLA_MAX_IN_FLIGHT=256
WEISSMAN_BOLA_LLM_PARALLEL=8
WEISSMAN_AUTO_SUPERPOSITION_COLLAPSE=1
WEISSMAN_OT_IP_CONCURRENCY=128
WEISSMAN_SWARM_ASM_TARGET_LIMIT=10000
WEISSMAN_NSS_MAX_CONCURRENT=1024
WEISSMAN_NSS_AGENT_COUNT=4096
WEISSMAN_IAC_LIVE_AWS=1
WEISSMAN_MAX_CONCURRENT_FULL_SCANS=4
WEISSMAN_SCAN_QUEUE_WAIT_SECS=300
WEISSMAN_MAX_PERSIST_FINDINGS=20000
WEISSMAN_POST_PERSIST_DB_CONCURRENCY=12
WEISSMAN_BG_DB_CONCURRENCY=16
WEISSMAN_INTEL_CACHE_MAX_ENTRIES=32768

# --- Autonomous / CEO ---
WEISSMAN_SOVEREIGN_EVOLUTION=1
WEISSMAN_STRATEGIC_THINKING_CONCURRENCY=32
WEISSMAN_GENESIS_PROTOCOL=1
WEISSMAN_GENESIS_AUTO_POE=1
WEISSMAN_GENESIS_DFS_MAX_DEPTH=16
WEISSMAN_GENESIS_RAM_BUDGET_MB=8192
WEISSMAN_GENESIS_WALL_SECS=2700
WEISSMAN_POE_JOB_WALL_SECS=7200
WEISSMAN_SELF_IMPROVE=1
WEISSMAN_SELF_IMPROVE_INTERVAL_SECS=3600
WEISSMAN_GENERAL_SELF_AUDIT_INTERVAL_SECS=3600
WEISSMAN_GENERAL_SELF_AUDIT_TENANT_ID=1
WEISSMAN_ASCENSION_AUTONOMOUS_ENQUEUE=1
WEISSMAN_ASCENSION_AUTONOMOUS_I_ACKNOWLEDGE=1
WEISSMAN_ASCENSION_MAX_JOBS=24
WEISSMAN_ASCENSION_LLM_RANK=1
WEISSMAN_ASCENSION_AUTO_POE_SYNTHESIS=1
WEISSMAN_ASCENSION_AUTO_POE_I_ACKNOWLEDGE=1
WEISSMAN_SOVEREIGN_MPSC_CAPACITY=256
WEISSMAN_SOVEREIGN_HONEYTOKEN_INTERVAL_SECS=300
WEISSMAN_SOVEREIGN_SELF_SCAN_INTERVAL_SECS=3600
WEISSMAN_SELFHEAL_RECOVERY_ENABLED=1
WEISSMAN_SELFHEAL_SHARED_STATE_ENABLED=1
WEISSMAN_HEAL_TOURNAMENT_SIZE=6
WEISSMAN_HEAL_TOURNAMENT_CONCURRENCY=4
WEISSMAN_HEAL_MAX_ATTEMPTS=10
WEISSMAN_REGRESSION_ALERT=1
WEISSMAN_AUDIT_CHECKPOINT_SECS=3600

# --- Background workers ---
WEISSMAN_REDTEAM_CRON=1
WEISSMAN_REDTEAM_INTERVAL_SECS=3600
WEISSMAN_THREAT_INGEST_CRON=1
WEISSMAN_THREAT_INGEST_INTERVAL_SECS=600
WEISSMAN_SCAN_SCHEDULE_CRON=1
WEISSMAN_ALERT_EVAL_CRON=1
WEISSMAN_SOAR_VERIFY_WORKER=1
WEISSMAN_INTEL_KEV_ENABLED=1
WEISSMAN_INTEL_EPSS_ENABLED=1
WEISSMAN_VERIFY_RUN_TESTS=1
WEISSMAN_VERIFY_REQUIRE_BEFORE_SUCCESS=1
WEISSMAN_VERIFY_REQUIRE_HEALTH=1

# --- Throughput (worker pool auto-raises with heavy concurrency) ---
WEISSMAN_WORKER_HEAVY_CONCURRENCY=6
WEISSMAN_WORKER_LIGHT_CONCURRENCY=16
WEISSMAN_FLEET_SHAPING=1
WEISSMAN_FLEET_BASE_RATE=24
WEISSMAN_FLEET_BURST=48
WEISSMAN_HTTP_POOL_MAX_IDLE=256
WEISSMAN_HTTP_POOL_IDLE_SECS=600
WEISSMAN_HTTP_TCP_KEEPALIVE_SECS=60

# --- Lab / self-hosted so every engine can actually run ---
WEISSMAN_BILLING_STRICT=0
WEISSMAN_ALLOW_PRIVATE_SCAN_TARGETS=1

# --- Force OFF: weaker, fake, or extra-token cloud actions ---
WEISSMAN_ADVISORY_FINDINGS=0
WEISSMAN_STEALTH_DISABLED=0
WEISSMAN_ALLOW_INSECURE_TLS=0
WEISSMAN_DISABLE_SECURITY_HEADERS=0
WEISSMAN_SAML_INSECURE_SKIP_VERIFY=0
WEISSMAN_FULL_CLOAK_ENABLE=0
WEISSMAN_DECEPTION_CF_BLACKHOLE_ENABLE=0
WEISSMAN_HEAL_AUTO_MERGE=0
WEISSMAN_AUTOHEAL_SKIP_SANDBOX=0
WEISSMAN_PANIC_EXIT_ON_FATAL=0
WEISSMAN_DISABLE_DATA_RETENTION=0
WEISSMAN_LIQUID_MATRIX_SDN_ENFORCED=0
